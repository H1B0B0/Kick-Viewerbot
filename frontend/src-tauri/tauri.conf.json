{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VelBots Creator Studio",
  "version": "4.0.0-6",
  "identifier": "com.velbots.kickviewerbot",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev:sidecar && npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "VelBots",
        "width": 1100,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: http://127.0.0.1:*; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* https://api.velbots.shop; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": ["bin/backend"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["velbots"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3Nzk4RkI2RjBBQTgwNEYKUldSUGdLcnd0bzk1bDBvZHl5dzNtaFlBUUdFSWJrWVBNdHpYY3BLclQzSVBuUEowSUpqQXdOOXgK",
      "endpoints": [
        "https://github.com/H1B0B0/Kick-Viewerbot/releases/latest/download/latest.json"
      ]
    }
  }
}
