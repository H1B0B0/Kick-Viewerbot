{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://www.patreon.com/*"
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}